{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pub-agent-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTERS",
        "class_name": "CounterDurableObject"
      },
      {
        "name": "DOCUMENTS",
        "class_name": "DocumentDurableObject"
      }
    ]
  },
  "exports": {
    "CounterDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DocumentDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ]
}
