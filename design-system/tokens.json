{
  "$description": "Canonical Pub Agent design tokens. Foundation values are consumed only by semantic aliases.",
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#FFFFFF" },
      "50": { "$type": "color", "$value": "#F8FAFC" },
      "100": { "$type": "color", "$value": "#F1F5F9" },
      "300": { "$type": "color", "$value": "#CBD5E1" },
      "500": { "$type": "color", "$value": "#64748B" },
      "700": { "$type": "color", "$value": "#334155" },
      "900": { "$type": "color", "$value": "#0F172A" }
    },
    "indigo": {
      "50": { "$type": "color", "$value": "#EEF2FF" },
      "500": { "$type": "color", "$value": "#4F46E5" },
      "600": { "$type": "color", "$value": "#4338CA" },
      "700": { "$type": "color", "$value": "#3730A3" }
    },
    "red": { "600": { "$type": "color", "$value": "#DC2626" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4" },
    "2": { "$type": "dimension", "$value": "8" },
    "3": { "$type": "dimension", "$value": "12" },
    "4": { "$type": "dimension", "$value": "16" },
    "6": { "$type": "dimension", "$value": "24" },
    "8": { "$type": "dimension", "$value": "32" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6" },
    "md": { "$type": "dimension", "$value": "10" },
    "lg": { "$type": "dimension", "$value": "16" }
  },
  "font": {
    "body": { "$type": "fontFamily", "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" }
  },
  "type": {
    "body": { "$type": "typography", "$value": { "fontSize": "16", "lineHeight": "24", "fontWeight": "400" } },
    "label": { "$type": "typography", "$value": { "fontSize": "14", "lineHeight": "20", "fontWeight": "600" } },
    "title": { "$type": "typography", "$value": { "fontSize": "20", "lineHeight": "28", "fontWeight": "600" } },
    "headline": { "$type": "typography", "$value": { "fontSize": "28", "lineHeight": "36", "fontWeight": "700" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120" },
    "standard": { "$type": "duration", "$value": "200" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "layout": {
    "gutter": { "$type": "dimension", "$value": "16" },
    "contentMax": { "$type": "dimension", "$value": "1120" },
    "compact": { "$type": "dimension", "$value": "360" },
    "medium": { "$type": "dimension", "$value": "768" },
    "expanded": { "$type": "dimension", "$value": "1280" }
  },
  "theme": {
    "light": {
      "text": { "primary": { "$type": "color", "$value": "{color.neutral.900}" }, "secondary": { "$type": "color", "$value": "{color.neutral.700}" }, "inverse": { "$type": "color", "$value": "{color.neutral.0}" }, "onAction": { "$type": "color", "$value": "{color.neutral.0}" } },
      "surface": { "base": { "$type": "color", "$value": "{color.neutral.0}" }, "raised": { "$type": "color", "$value": "{color.neutral.50}" }, "selected": { "$type": "color", "$value": "{color.indigo.50}" } },
      "border": { "default": { "$type": "color", "$value": "{color.neutral.300}" }, "focus": { "$type": "color", "$value": "{color.indigo.600}" } },
      "action": { "primary": { "$type": "color", "$value": "{color.indigo.600}" }, "primaryPressed": { "$type": "color", "$value": "{color.indigo.700}" }, "danger": { "$type": "color", "$value": "{color.red.600}" } },
      "status": { "error": { "$type": "color", "$value": "{color.red.600}" } }
    },
    "dark": {
      "text": { "primary": { "$type": "color", "$value": "{color.neutral.50}" }, "secondary": { "$type": "color", "$value": "{color.neutral.300}" }, "inverse": { "$type": "color", "$value": "{color.neutral.900}" }, "onAction": { "$type": "color", "$value": "{color.neutral.0}" } },
      "surface": { "base": { "$type": "color", "$value": "{color.neutral.900}" }, "raised": { "$type": "color", "$value": "{color.neutral.700}" }, "selected": { "$type": "color", "$value": "{color.indigo.700}" } },
      "border": { "default": { "$type": "color", "$value": "{color.neutral.500}" }, "focus": { "$type": "color", "$value": "{color.indigo.500}" } },
      "action": { "primary": { "$type": "color", "$value": "{color.indigo.500}" }, "primaryPressed": { "$type": "color", "$value": "{color.indigo.600}" }, "danger": { "$type": "color", "$value": "{color.red.600}" } },
      "status": { "error": { "$type": "color", "$value": "{color.red.600}" } }
    }
  }
}
